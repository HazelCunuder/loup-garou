{
  "framework": "django",
  "buildCommand": "pip install -r requirements.txt && cd loup-garou && pip install dj_database_url psycopg2-binary",
  "outputDirectory": "loup-garou/staticfiles",
  "region": "auto",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "env": {
    "database": {
      "production": {
        "url": "@pgsql"
      }
    }
  }
}